# Server
PORT=5000
BASE_API_URL=http://localhost:5000
BASE_WEB_URL=http://localhost:5002
BASE_ADMIN_URL=http://localhost:5002
NODE_ENV=development

### GraphQL
APOLLO_GRAPH_REF=
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=200
GRAPHQL_CACHE_TTL_SEC=5
GRAPHQL_PERSISTED_QUERY_TTL_SEC=300

### Auth
JWT_ACCESS_SECRET=umaChaveMuitoSecreta
JWT_ACCESS_EXPIRES_IN=1h
JWT_CONTEXT_SECRET=outraChaveMuitoSecreta
AUTH_REFRESH_TOKEN_TTL_SEC=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax
AUTH_INVITE_TTL_HOURS=72
AUTH_CHALLENGE_TTL_MINUTES=10
AUTH_MAX_CHALLENGE_ATTEMPTS=5
AUTH_CSRF_TTL_SEC=2592000
AUTH_IOS_TEAM_ID=
AUTH_IOS_BUNDLE_ID=
AUTH_ANDROID_PACKAGE_NAME=
AUTH_ANDROID_SHA256_CERT_FINGERPRINTS=
AUTH_APP_LINK_PATHS=/auth/login/magic*
AUTH_RATE_LIMIT_WINDOW_SEC=600
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Database Config
DATABASE_URL=postgresql://docker:docker@localhost:5432/postgres?schema=public
PRISMA_LOG_ERROR=false
PRISMA_LOG_WARN=false
PRISMA_LOG_INFO=false
PRISMA_LOG_QUERY=false
PRISMA_ERROR_FORMAT=pretty

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB_QUEUE=0
REDIS_DB_WS=1
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_KEEP_ALIVE_MS=30000
REDIS_MAX_RETRIES=10
REDIS_MAX_RETRIES_PER_REQUEST=
REDIS_KEY_PREFIX=ad-fusion:
QUEUE_CLEAN_ON_STARTUP=

### Correction / OMR
OMR_BASE_URL=http://localhost:11001
OMR_REQUEST_TIMEOUT_MS=30000
CORRECTION_DEBUG_TRACE=false
CORRECTION_AUDIT_RETENTION_DAYS=365
CORRECTION_RETENTION_INTERVAL_HOURS=24

### Storage
STORAGE_ENVIRONMENT=local # enum: (local, cloud)
STORAGE_CLOUD_FRONT_URL=http://localhost:4566
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_BUCKET=ad-fusion
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID="key"
AWS_SECRET_ACCESS_KEY="secret"

# E-mail
EMAIL_DEFAULT_FROM=noreply@grupoigd.com
EMAIL_DEFAULT_FROM_NAME=IGD Agents
EMAIL_DRIVER=ethereal
SENDGRID_API_KEY=
