{
   "name": "auth-microservice-api",
   "version": "0.0.1",
   "description": "",
   "private": true,
   "scripts": {
      "build": "nest build",
      "format": "prettier --write \"src/**/*.ts\"",
      "start": "nest start",
      "start:dev": "nest start --watch",
      "start:debug": "nest start --debug --watch",
      "start:prod": "node dist/main",
      "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "test": "jest --config jest.config.cjs --runInBand",
      "test:watch": "jest --config jest.config.cjs --watch",
      "test:auth": "jest --config jest.config.cjs --runInBand src/modules/auth",
      "db:reset": "pnpm prisma migrate reset",
      "db:push": "pnpm prisma db push && pnpm db:seed",
      "db:seed": "pnpm ts-node ./prisma/seed/index.ts",
      "db:reset:dev": "pnpm db:reset",
      "db:deploy": "pnpm prisma migrate deploy",
      "db:migrate": "pnpm prisma migrate dev",
      "studio": "prisma studio",
      "generate": "prisma generate && node ./scripts/post-generate-class-transformer-types.cjs"
   },
   "dependencies": {
